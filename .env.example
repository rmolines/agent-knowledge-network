# Agent Knowledge Network — required environment variables
# Copy to .env and fill in values. Never commit .env.

# GitHub OAuth App (create at github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/callback

# Database (Railway provides this automatically in production)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/akn

# Redis (Railway provides this automatically in production)
REDIS_URL=redis://localhost:6379

# Security — generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
